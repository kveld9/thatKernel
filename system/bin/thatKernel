#!/system/bin/sh

write() {
    [ ! -f "$1" ] && return 1
    chmod +w "$1" 2>/dev/null
    if ! echo "$2" > "$1" 2>/dev/null; then
        echo "Failed: $1 → $2"
        return 1
    fi
}

LOG_FILE="/data/adb/thatKernel.log"

LOG() {
    echo "$1" >> "$LOG_FILE"
}

LOG_D() {
    echo "($(date '+%Y-%m-%d - %H:%M:%S')): $1" >> "$LOG_FILE"
}

LOG "～～～～～～～～～～～～～～～～～～"
LOG "- WELCOME TO </>thatKernel -"
LOG "• v0.1.0"
LOG "• DEVICE - $(getprop ro.product.brand) $(getprop ro.product.system.model)"
LOG "• ROM - $(getprop ro.product.name)"
LOG "• ANDROID - $(getprop ro.build.version.release)"
LOG "• KERNEL - $(uname -r)"
LOG "～～～～～～～～～～～～～～～～～～"

LOG_D "- Stopping background tracing and diagnostic daemons..."
for service in statsd traced traced_probes cnss_diag vendor.cnss_diag tcpdump vendor.tcpdump dumpstate; do
    stop "$service" 2>/dev/null
done
LOG_D "- Finished stopping daemons."

LOG_D "- Disabling kernel tracing and debug nodes..."
for node in \
    /sys/kernel/tracing/tracing_on \
    /sys/kernel/debug/tracing/tracing_on \
    /sys/kernel/tracing/instances/*/tracing_on \
    /sys/kernel/debug/dri/0/debug/enable \
    /sys/kernel/debug/sde_rotator0/evtlog/enable; do
    write "$node" 0
done

write "/proc/sys/kernel/sched_schedstats" 0
write "/proc/sys/debug/exception-trace" 0
write "/proc/sys/net/ipv4/tcp_no_metrics_save" 1
write "/sys/module/spurious/parameters/noirqdebug" 1

LOG_D "- Disabling printk and devkmsg..."
write "/proc/sys/kernel/printk" "0 0 0 0"
write "/proc/sys/kernel/printk_devkmsg" "off"

LOG_D "- Disabling ramdumps..."
write "/sys/module/subsystem_restart/parameters/enable_mini_ramdumps" 0
write "/sys/module/subsystem_restart/parameters/enable_ramdumps" 0
write "/sys/module/subsystem_restart/parameters/enable_debug" 0

LOG_D "- Disabling block I/O stats..."
for q in /sys/block/*/queue/iostats; do
    write "$q" 0
done

LOG_D "- Disabling memory dumps..."
write "/proc/sys/vm/oom_dump_tasks" 0
write "/proc/sys/vm/block_dump" 0

LOG "～～～～～～～～～～～～～～～～～～～～～～～～～"
LOG_D "</>thatKernel was successfully applied."
LOG "～～～～～～～～～～～～～～～～～～～～～～～～～"

exit 0
